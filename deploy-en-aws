pipeline {
    agent any

    environment {
        CREDENCIALES_AWS = credentials('AWS')
        SSH_KEY = credentials('terraform-ec2-key') 
        DOCKER_IMAGE = "rhxpchispi/myapp-alpine:dev"
        EC2_PUBLIC_IP = "3.231.145.76"
        DOCKER_CONTAINER_NAME = "myapp-en-aws" // Nombre del contenedor que se va a desplegar
    }

    stages {
        stage('Deploy Docker Image') {
            steps {
                script {
                    // Conexión SSH para desplegar el contenedor
                    sh """
                    chmod 400 ${SSH_KEY} << EOF
                    ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no ubuntu@${EC2_PUBLIC_IP}                         
                        set -e
                        
                        export AWS_ACCESS_KEY_ID=${CREDENCIALES_AWS_USR}
                        export AWS_SECRET_ACCESS_KEY=${CREDENCIALES_AWS_PSW}

                        echo "===> Tirando la última versión de la imagen: ${DOCKER_IMAGE}"
                        docker pull ${DOCKER_IMAGE}
                        
                        echo "===> Deteniendo el contenedor si está en ejecución"
                        docker stop ${DOCKER_CONTAINER_NAME} || true
                        docker rm ${DOCKER_CONTAINER_NAME} || true

                        echo "===> Desplegando el contenedor"
                        docker run -d --name ${DOCKER_CONTAINER_NAME} -p 3000:3000 ${DOCKER_IMAGE}
                        
                        unset AWS_ACCESS_KEY_ID
                        unset AWS_SECRET_ACCESS_KEY
                    EOF
                    """
                }
            }
        }
    }
}